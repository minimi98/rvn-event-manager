rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function beforeDeadline() {
      return request.time < timestamp.date(2027, 12, 31);
    }

    match /scores/{scoreId} {
      allow read: if beforeDeadline();
      allow create, update: if beforeDeadline()
        && request.resource.data.participantId is string
        && request.resource.data.stationId is string
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points <= 200;
      allow delete: if beforeDeadline();
    }

    match /settings/{document} { allow read, write: if beforeDeadline(); }
    match /roles/{document} { allow read, write: if beforeDeadline(); }
    match /helpers/{document} { allow read, write: if beforeDeadline(); }
    match /participants/{document} { allow read, write: if beforeDeadline(); }
    match /alerts/{document} { allow read, write: if beforeDeadline(); }
    match /meta/{document} { allow read, write: if beforeDeadline(); }

    match /{document=**} { allow read, write: if false; }
  }
}
